# =============================================================================
# Sentinel IP AI - environment configuration
# Copy to `.env` and edit.  NEVER commit the real .env file.
# =============================================================================

APP_NAME="Sentinel IP AI"
APP_ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database (MySQL 8.x / MariaDB 10.6+)
# -----------------------------------------------------------------------------
# Either set DATABASE_URL directly...
# DATABASE_URL=mysql+pymysql://sentinel:sentinel@127.0.0.1:3306/sentinel_ip?charset=utf8mb4
# ...or set the parts below and let the app assemble it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=sentinel_ip
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=U92TVZWYkBChydSnyWYYePCI-w3V-HuOrKub-0wi9Jfn4599yN9Ny9QncgNQ5dOZ22fEOVwyJcsK4rdJURlwCQ
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_MINUTES=10080          # 7 days
PASSWORD_HASH_SCHEME=bcrypt               # bcrypt | argon2
COOKIE_NAME=sentinel_session
COOKIE_SECURE=false                       # MUST be true behind HTTPS in production
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=sentinel_csrf

# Login throttling
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ACCOUNT_LOCKOUT_ATTEMPTS=10
ACCOUNT_LOCKOUT_MINUTES=15

# Password policy
PASSWORD_MIN_LENGTH=12

# Comma-separated. Use explicit origins in production, never "*" with credentials.
CORS_ORIGINS=http://localhost:8005,http://127.0.0.1:8005

# -----------------------------------------------------------------------------
# File uploads (evidence)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.csv,.xls,.xlsx

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
# mock | openai | gemini   -- "mock" needs no API key and is the default.
AI_PROVIDER=mock
AI_MODEL=sentinel-mock-v1
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MOCK_SEED=1337                          # deterministic demo output
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# -----------------------------------------------------------------------------
# Enforcement / autonomy
# -----------------------------------------------------------------------------
DEFAULT_AUTONOMY_TIER=1                    # new vendors/users default to Tier 1
MAX_AUTONOMY_TIER=3                        # Tier 4 is reserved; raise deliberately
SIMULATED_FILING=true                      # true => filings are labelled DEMO / SIMULATED
DEFAULT_SLA_HOURS=48
SLA_AT_RISK_PERCENT=75                     # % of SLA window elapsed => "At Risk"

# -----------------------------------------------------------------------------
# Seed data (development only)
# -----------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD=Sentinel!Demo2026
